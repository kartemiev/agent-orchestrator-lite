# =========================================================================
# agent-orchestrator-lite — пример переменных окружения.
# Скопируй в .env и заполни реальными значениями:
#   cp .env.example .env
# Файл .env находится в .gitignore и не попадает в репозиторий.
# =========================================================================

# --- IP для публикации портов стека (docker-compose.yml: ${BIND_IP:-127.0.0.1}) ---
# По умолчанию сервисы слушают только localhost. Gateway API публикуется на
# ${BIND_IP}:8085, Streamlit UI — на ${BIND_IP}:8501, Temporal — на :7233.
# Для доступа через Tailscale укажите IP из `tailscale ip -4`.
BIND_IP=127.0.0.1

# --- LLM Configuration (OpenAI / OpenRouter / DeepSeek) -------------------
# Эти переменные читает agent-orchestrator и передаёт в OpenHands при создании
# каждой фазы (model / api_key / base_url). Поддерживается любой
# OpenAI-совместимый провайдер. Имя модели берётся из LLM_MODEL: можно указывать
# как базовое имя провайдера (deepseek-v4-pro, gpt-4o), так и LiteLLM-префикс
# (openrouter/..., deepseek/...).

# Основной пример (рабочая среда): DeepSeek
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Альтернатива 1: OpenAI (раскомментируй и закомментируй блок выше)
# LLM_API_KEY=your_openai_api_key
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Альтернатива 2: OpenRouter
# LLM_API_KEY=your_openrouter_api_key
# LLM_API_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/openai/gpt-4o-mini

# --- GitHub Access ---------------------------------------------------------
# Токен для clone/pull приватных репозиториев и создания Pull Request.
# Нужен и агенту OpenHands (terminal), и оркестратору (git_push_and_create_pr).
GITHUB_TOKEN=your_github_token

# --- OpenHands / agent-canvas ---
# Фиксированный X-Session-API-Key сервиса openhands (LOCAL_BACKEND_API_KEY).
# Должен совпадать у openhands и agent-orchestrator (OPENHANDS_API_KEY).
OPENHANDS_SESSION_API_KEY=dev

# --- Изоляция workspace ---
# Каждый workflow работает в /app/workspace/runs/{workflow_id}.
# SOURCE_REPO_PATH=/app/workspace/repo  — базовый репозиторий, чьё содержимое
#                                         копируется в workspace каждого workflow.
# Удалять ли workspace после завершения workflow (true/false).
CLEANUP_WORKSPACE=true

# --- Ширина волны DAG ---
# Сколько агентских фаз стартует параллельно в одной волне (защита от 429).
WAVE_MAX_CONCURRENCY=4

# --- Потолок LRU-кэша workflow в Temporal-воркере (по умолчанию 1000) ---
TEMPORAL_MAX_CACHED_WORKFLOWS=200
