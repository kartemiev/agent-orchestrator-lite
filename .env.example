# =============================================================================
# agent-orchestrator-lite — environment variables template.
# / Шаблон переменных окружения agent-orchestrator-lite.
#
# Copy it to .env and fill in the real values:
#   cp .env.example .env
# The .env file is gitignored and never committed.
# / Скопируй в .env и заполни реальными значениями:
#   cp .env.example .env
# Файл .env находится в .gitignore и не попадает в репозиторий.
# =============================================================================

# --- IP used to publish the stack ports (docker-compose.yml: ${BIND_IP:-127.0.0.1}) ---
# By default the services listen on localhost only. The Gateway API is published
# on ${BIND_IP}:${ORCHESTRATOR_GATEWAY_PORT}, the Streamlit UI on
# ${BIND_IP}:${STREAMLIT_PORT}, OpenHands on ${BIND_IP}:${AGENT_CANVAS_PORT},
# Temporal on ${BIND_IP}:${TEMPORAL_PORT}. For Tailscale access use the IP from
# `tailscale ip -4`.
# / По умолчанию сервисы слушают только localhost. Gateway API публикуется на
# ${BIND_IP}:${ORCHESTRATOR_GATEWAY_PORT}, Streamlit UI — на ${BIND_IP}:${STREAMLIT_PORT},
# OpenHands — на ${BIND_IP}:${AGENT_CANVAS_PORT}, Temporal — на ${BIND_IP}:${TEMPORAL_PORT}.
# Для доступа через Tailscale укажите IP из `tailscale ip -4`.
BIND_IP=127.0.0.1

# --- Service ports (docker-compose.yml) ---
# Host ports the containers are published on. Change them here if they are taken.
# / Хостовые порты, на которых публикуются контейнеры. Меняйте здесь, если порты заняты.
ORCHESTRATOR_GATEWAY_PORT=8085
STREAMLIT_PORT=8501
AGENT_CANVAS_PORT=8000
TEMPORAL_PORT=7233

# --- Container memory limits (docker-compose.yml) ----------------------------
# Hard cgroup RAM limits for the OpenHands and orchestrator containers.
# memswap_limit is set equal to mem_limit (swap is disabled for the container),
# so under load the container gets a predictable OOM-kill instead of dragging
# the host into swap. Docker size format: 512m, 2g, 4g, etc.
# / Жёсткий cgroup-лимит RAM для контейнеров OpenHands и оркестратора.
# memswap_limit выставляется равным mem_limit (своп для контейнера отключён),
# чтобы под нагрузкой контейнер не утащил хост в swap, а получил предсказуемый
# OOM-kill. Формат Docker size: 512m, 2g, 4g и т.д.
ORCHESTRATOR_MEM_LIMIT=2g
OPENHANDS_MEM_LIMIT=4g

# --- LLM Configuration (OpenAI / Anthropic / OpenRouter / DeepSeek) ---------
# These variables are read by agent-orchestrator-lite and passed to OpenHands
# when creating each phase (model / api_key / base_url). Any OpenAI-compatible
# provider is supported. The model name comes from LLM_MODEL: either a provider
# base name (deepseek-v4-pro, gpt-4o) or a LiteLLM prefix
# (openrouter/..., deepseek/..., anthropic/...).
# Important: personal ChatGPT Plus / Claude Pro subscriptions do NOT work for the
# API — you need a billing-enabled account with a balance
# (platform.openai.com / console.anthropic.com).
# / Эти переменные читает agent-orchestrator-lite и передаёт в OpenHands при
# создании каждой фазы (model / api_key / base_url). Поддерживается любой
# OpenAI-совместимый провайдер. Имя модели берётся из LLM_MODEL: базовое имя
# провайдера (deepseek-v4-pro, gpt-4o) или LiteLLM-префикс
# (openrouter/..., deepseek/..., anthropic/...).
# Важно: личные подписки ChatGPT Plus / Claude Pro для API не подходят —
# нужен платёжный аккаунт с балансом (platform.openai.com / console.anthropic.com).

# Primary example (working environment): DeepSeek
# / Основной пример (рабочая среда): DeepSeek
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://api.deepseek.com
# LLM_BASE_URL is an explicit alias of LLM_API_URL (for SDKs that expect
# *_BASE_URL, e.g. LiteLLM / OpenAI clients). If both are set, LLM_BASE_URL wins.
# / LLM_BASE_URL — явный синоним LLM_API_URL (для SDK, ожидающих *_BASE_URL).
# Если заданы оба — приоритет у LLM_BASE_URL.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# Alternative 1: OpenAI (GPT-4o)
# (uncomment the block you need and comment out the block above)
# / Альтернатива 1: OpenAI (GPT-4o) — раскомментируй нужный блок и закомментируй блок выше.
# LLM_API_KEY=your_openai_api_key
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Alternative 2: Anthropic (Claude 3.5 Sonnet)
# / Альтернатива 2: Anthropic (Claude 3.5 Sonnet)
# LLM_API_KEY=sk-ant-api03-...
# LLM_API_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-5-sonnet-20241022

# Alternative 3: OpenRouter
# / Альтернатива 3: OpenRouter
# LLM_API_KEY=your_openrouter_api_key
# LLM_API_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/openai/gpt-4o-mini

# --- GitHub Access -----------------------------------------------------------
# Token for cloning/pulling private repositories and creating Pull Requests.
# Needed by both the OpenHands agent (terminal) and the orchestrator
# (git_push_and_create_pr).
# / Токен для clone/pull приватных репозиториев и создания Pull Request.
# Нужен и агенту OpenHands (terminal), и оркестратору (git_push_and_create_pr).
GITHUB_TOKEN=your_github_token

# Disables interactive git prompts (login/password input). Without it the
# OpenHands agent may hang waiting for input when cloning a private repository.
# / Отключает интерактивные подсказки git (ввод логина/пароля). Без этого агент
# OpenHands может зависнуть в ожидании ввода при клонировании приватного репозитория.
GIT_TERMINAL_PROMPT=0

# --- OpenHands / agent-canvas ---
# Fixed X-Session-API-Key of the openhands service (LOCAL_BACKEND_API_KEY).
# Must match between openhands and agent-orchestrator (OPENHANDS_API_KEY).
# / Фиксированный X-Session-API-Key сервиса openhands (LOCAL_BACKEND_API_KEY).
# Должен совпадать у openhands и agent-orchestrator (OPENHANDS_API_KEY).
OPENHANDS_SESSION_API_KEY=dev

# --- Workspace isolation ---
# Each workflow runs in /app/workspace/runs/{workflow_id}.
# SOURCE_REPO_PATH=/app/workspace/repo — a base repository whose contents are
#                                        copied into the workspace of each workflow.
# Whether to remove the workspace after the workflow completes (true/false).
# / Каждый workflow работает в /app/workspace/runs/{workflow_id}.
# SOURCE_REPO_PATH=/app/workspace/repo — базовый репозиторий, чьё содержимое
#                                        копируется в workspace каждого workflow.
# Удалять ли workspace после завершения workflow (true/false).
CLEANUP_WORKSPACE=true

# --- DAG wave width ---
# How many agent phases start in parallel within one wave (protection against 429).
# / Сколько агентских фаз стартует параллельно в одной волне (защита от 429).
WAVE_MAX_CONCURRENCY=4

# --- LRU cache cap for workflows in the Temporal worker (default 1000) ---
# / Потолок LRU-кэша workflow в Temporal-воркере (по умолчанию 1000).
TEMPORAL_MAX_CACHED_WORKFLOWS=200
